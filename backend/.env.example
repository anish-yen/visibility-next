# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
DATABASE_URL=

REDIS_URL=

# LLM
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional: comma-separated list for key rotation/fallback
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash

# Stripe
# Prefer a Restricted API Key (rk_...) scoped to Checkout Sessions + Webhook
# Endpoints over a full secret key (sk_...). Never commit the real value -
# set it directly in your platform's env vars (Render dashboard, local .env).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
FRONTEND_URL=http://localhost:3000

# Comma-separated emails that skip Stripe checkout and get an audit immediately
QA_BYPASS_EMAILS=
