# Copy values into backend/.env and frontend/.env.local (see README).

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# gemini-2.0-flash was sunset by Google (404s on every call as of Oct 2026);
# gemini-2.5-flash is confirmed working for both plain generation and the
# google_search grounding tool. Re-check available models if this 404s again:
# GET https://generativelanguage.googleapis.com/v1beta/models?key=...
GEMINI_MODEL=gemini-2.5-flash
REDIS_URL=
DATABASE_URL=

# Next.js (same URL and anon key as above; exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI base URL for dashboard fetches (default http://localhost:8000 if unset)
NEXT_PUBLIC_API_URL=http://localhost:8000
